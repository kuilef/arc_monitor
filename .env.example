# CLI and ASGI load .env; process environment wins, then explicit CLI flags.
# Never commit .env, keys, or private RPC URLs.
ARC_DB=data/arc.db
BITQUERY_TOKEN=
ARC_RPC_URL=
ARC_MODE=live
ARC_MAX_TOKENS=500
ARC_REQUESTS_PER_MINUTE=6
ARC_POINTS_PER_RUN=100
ARC_POINTS_PER_DAY=200
ARC_POINTS_PER_REQUEST=10
ARC_POINTS_RESERVE=20
# Optional known token expiry; billing-period end is not token expiry.
# ARC_TOKEN_EXPIRES_AT=2026-10-01T00:00:00Z
# Telegram requires eligible research and --telegram / notify --send.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
